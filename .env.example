# .env.example — copy to .env and fill in values
# NEVER commit the real .env file to version control

# ── MySQL / DVWA ──────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=dvwa
MYSQL_USER=dvwa
MYSQL_PASSWORD=change_me_dvwa

# ── PHP-Apache app DB ─────────────────────────────────────────────────────────
APP_DB_HOST=mysql
APP_DB_NAME=webapp
APP_DB_USER=webapp
APP_DB_PASSWORD=change_me_app

# ── DVWA settings ─────────────────────────────────────────────────────────────
DVWA_SECURITY_LEVEL=low

# ── ZAP ───────────────────────────────────────────────────────────────────────
ZAP_API_KEY=change_me_zap_key

# ── BeEF ──────────────────────────────────────────────────────────────────────
BEEF_PASSWORD=change_me_beef

# ── Application secret (CSRF / sessions) ─────────────────────────────────────
APP_SECRET=change_me_app_secret_32chars_min
